{
  "expo": {
    "name": "Zubba Customer",
    "slug": "zubba-frontend",
    "owner": "andyaa",
    "scheme": "com.zubba.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zubbadevs.zubba"
    },
    "android": {
      "package": "com.zubba.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": {},
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/zubba-icon-white.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#2EA043"
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "f54db8fc-b548-4fb4-92ac-755981574a54"
      }
    }
  }
}
